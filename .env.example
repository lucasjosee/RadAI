# Porta do servidor (padrão: 8080)
PORT=8080

# PostgreSQL — conexão com o banco de dados
DB_URL=jdbc:postgresql://localhost:5432/saas_raiox
DB_USER=postgres
DB_PASS=sua_senha_aqui

# Azure Custom Vision — chaves de acesso ao modelo de IA
# Obtenha em: portal.azure.com > Custom Vision > seu projeto > Prediction URL
AZURE_URL=https://seu-endpoint.cognitiveservices.azure.com/customvision/v3.0/Prediction/...
AZURE_KEY=sua_chave_de_predicao_aqui
